# Indicate that we want to use the python:3.9 docker image
FROM python:3.9

# Copy just the requirements.txt for dependences
COPY ./src/requirements.txt /app/requirements.txt


# Set our working directory for future commands
# Acts as a `cd`
WORKDIR /app

# Tell the docker engine to run a pip install in our image
RUN pip install -r requirements.txt

# Copy the rest of our python files
COPY ./src /app

# Tell docker to run our program!
CMD python3 -u main.py
